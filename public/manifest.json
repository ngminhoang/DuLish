{
  "manifest_version": 3,
  "name": "DuLish",
  "version": "1.0",
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "32": "32.png"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/contentScript.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["english-vietnamese.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}