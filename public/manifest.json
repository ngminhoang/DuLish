{
      "manifest_version": 3,
      "name": "DuLish",
      "version": "1.0",
      "action": {
        "default_popup": "index.html"
      },
      "icons": {
        "32": "dulish_icon.png"
      },
      "permissions": ["storage", "tabs", "scripting","identity"],
      "host_permissions": [
        "https://*/*",
        "http://*/*"
      ],
      "background": {
        "service_worker": "extension/background.js",
        "type": "module"
      },
      "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": ["extension/contentScript.js"]
        }
      ],
      "web_accessible_resources": [
        {
          "resources": ["english-vietnamese.txt","dulish.png"],
          "matches": ["<all_urls>"]
        }
      ],
      "oauth2": {
        "client_id": "280739678981-emmtu0c863ujidtk8cvakg1e15c5kc00.apps.googleusercontent.com",
        "scopes": ["openid", "email", "profile"]
      }
    }